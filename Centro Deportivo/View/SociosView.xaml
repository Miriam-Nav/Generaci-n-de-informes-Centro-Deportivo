<Window x:Class="View.SociosView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
                Title="Gestión de Socios"
        Height="680" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F7">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->
        <Border Style="{StaticResource BarraSup}">
            <DockPanel>
                <TextBlock Text="Gestión de Socios" Style="{StaticResource TituloBarraStyle}" DockPanel.Dock="Left"/>
            </DockPanel>

        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FORMULARIO EN TARJETA -->
            <Border Grid.Column="0" Style="{StaticResource TarjetaStyle}">

                <StackPanel>

                    <TextBlock Text="Datos del Socio" Style="{StaticResource TituloTarjetaStyle}"/>

                    <!-- Nombre -->
                    <TextBlock Text="Nombre *" Style="{StaticResource LabelStyle}"/>
                    <TextBox Text="{Binding Nombre}" Style="{StaticResource TextBoxStyle}"/>
                    <TextBlock Text="{Binding ErrorNombre}" Style="{StaticResource ErrorMensajeStyle}"/>

                    <!-- Email -->
                    <TextBlock Text="Email *"
                           Style="{StaticResource LabelStyle}"
                           Margin="0,15,0,0"/>
                    <TextBox Text="{Binding Email}" Style="{StaticResource TextBoxStyle}"/>
                    <TextBlock Text="{Binding ErrorEmail}" Style="{StaticResource ErrorMensajeStyle}"/>

                    <!-- Activo -->
                    <TextBlock Text="Estado" Style="{StaticResource LabelStyle}" Margin="0,15,0,10"/>
                    <CheckBox Content="Activo" IsChecked="{Binding Activo}"
                          FontSize="14" Foreground="#2C3E50"/>

                    <!-- Botones -->
                    <StackPanel Margin="0,25,0,0">
                        <Button Content="Crear Socio"
                            Command="{Binding CrearCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Modificar Socio"
                            Command="{Binding ModificarCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Eliminar Socio"
                            Command="{Binding EliminarCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Limpiar Formulario"
                            Command="{Binding LimpiarCommand}"
                            Style="{StaticResource LimpiarButtonStyle}"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- LISTA -->
            <Border Grid.Column="2" Style="{StaticResource ListaStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" 
                  ItemsSource="{Binding Socios}"
                  SelectedItem="{Binding SocioSeleccionado}"
                  Style="{StaticResource DataGridStyle}"
                  Margin="0,0,0,15">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" MinWidth="200"/>
                            <DataGridCheckBoxColumn Header="Activo" Binding="{Binding Activo}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1" 
                Content="Generar Informe Crystal Reports"
                Command="{Binding GenerarInformeCommand}" 
                Style="{StaticResource PrimaryButtonStyle}"
                Height="50"
                FontSize="16"
                FontWeight="Bold"
                Cursor="Hand"/>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>