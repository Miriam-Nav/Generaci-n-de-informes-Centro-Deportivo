<Window x:Class="View.ReservasView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
                Title="Gestión de Reservas"
        Height="680" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F7">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->
        <Border Style="{StaticResource BarraSup}">
            <DockPanel>
                <TextBlock Text="Gestión de Reservas" Style="{StaticResource TituloBarraStyle}" DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- FORMULARIO EN TARJETA -->
            <Border Grid.Column="0" Style="{StaticResource TarjetaStyle}">
                <StackPanel>
                    <TextBlock Text="Nueva Reserva" Style="{StaticResource TituloTarjetaStyle}"/>

                    <!-- Socio -->
                    <TextBlock Text="Socio *" Style="{StaticResource LabelStyle}" Margin="0,0,0,0"/>
                    <ComboBox ItemsSource="{Binding Socios}"
                              SelectedValue="{Binding SocioId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre"
                              Style="{StaticResource ComboBoxStyle}"/>

                    <TextBlock Text="{Binding ErrorSocio}" Style="{StaticResource ErrorMensajeStyle}"/>

                    <!-- Actividad -->
                    <TextBlock Text="Actividad *"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,15,0,0"/>
                    <ComboBox ItemsSource="{Binding Actividades}"
                              SelectedValue="{Binding ActividadId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Nombre"
                              Style="{StaticResource ComboBoxStyle}"/>

                    <TextBlock Text="{Binding ErrorActividad}" Style="{StaticResource ErrorMensajeStyle}"/>

                    <!-- Fecha -->
                    <TextBlock Text="Fecha *"
                               Style="{StaticResource LabelStyle}"
                               Margin="0,15,0,0"/>
                    <DatePicker SelectedDate="{Binding Fecha}" Style="{StaticResource DatePickerEstilo}"/>
                    <TextBlock Text="{Binding ErrorFecha}" Style="{StaticResource ErrorMensajeStyle}"/>
                    <TextBlock Text="{Binding ErrorAforo}" Style="{StaticResource ErrorMensajeStyle}"/>
                    <TextBlock Text="{Binding ErrorSolapamiento}" Style="{StaticResource ErrorMensajeStyle}"/>

                    <!-- Botones -->
                    <StackPanel Margin="0,15,0,0">
                        <Button Content="Crear Reserva"
                                Command="{Binding CrearCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Modificar Reserva"
                                Command="{Binding ModificarCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Eliminar Reserva"
                                Command="{Binding EliminarCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"/>

                        <Button Content="Limpiar Formulario"
                                Command="{Binding LimpiarCommand}"
                                Style="{StaticResource LimpiarButtonStyle}"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- LISTA -->
            <Border Grid.Column="2" Style="{StaticResource ListaStyle}">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid Grid.Row="0" 
                  ItemsSource="{Binding Reservas}"
                  SelectedItem="{Binding ReservaSeleccionada}"
                  Style="{StaticResource DataGridStyle}"
                  Margin="0,0,0,15">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Socio" Binding="{Binding Socio.Nombre}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Actividad" Binding="{Binding Actividad.Nombre}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="Fecha" Binding="{Binding Fecha, StringFormat=dd/MM/yyyy}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="1">
                        <Button Content="Generar Informe por Actividad"
                    Command="{Binding GenerarInformeCommand}" 
                    Style="{StaticResource PrimaryButtonStyle}"
                    Height="50"
                    FontSize="16"
                    FontWeight="Bold"
                    Cursor="Hand"/>

                        <Button Content="Generar Historial por Socio"
                    Command="{Binding GenerarHistorialCommand}" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Height="50"
                    FontSize="16"
                    FontWeight="Bold"
                    Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
