<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
                Title="Sistema de Gestión - Club Deportivo" 
        Height="680" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- BARRA SUPERIOR -->
        <Border Style="{StaticResource BarraSup}">
            <DockPanel>
                <TextBlock Text="Club Deportivo" Style="{StaticResource TituloBarraStyle}" DockPanel.Dock="Left"/>
            </DockPanel>
        </Border>

        <!-- CONTENIDO PRINCIPAL -->
        <Grid Grid.Row="1" Margin="0,40,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- MENSAJE -->

            <TextBlock Text="Selecciona una sección"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center" Margin="0,50,0,0"/>

            <!-- TARJETAS DE NAVEGACIÓN -->
            <UniformGrid Grid.Row="1"
                         Columns="3"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Top"
                         Margin="0,20,0,0">

                <!-- BOTON RESERVAS -->
                <Button Command="{Binding AbrirReservasCommand}" Style="{StaticResource BotonInicioStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="195">
                        <Image Source="/Assets/reservas.png" Width="150" Height="150"/>
                        <TextBlock Text="Reservas" Style="{StaticResource TituloTarjetaStyle}" FontSize="30" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- BOTON SOCIOS -->
                <Button Command="{Binding AbrirSociosCommand}" Style="{StaticResource BotonInicioStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="195">
                        <Image Source="/Assets/socios.png" Width="150" Height="150"/>
                        <TextBlock Text="Socios" Style="{StaticResource TituloTarjetaStyle}" FontSize="30" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- TARJETA ACTIVIDADES -->
                <Button Command="{Binding AbrirActividadesCommand}" Style="{StaticResource BotonInicioStyle}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Height="195">
                        <Image Source="/Assets/actividades.png" Width="150" Height="150"/>
                        <TextBlock Text="Actividades" Style="{StaticResource TituloTarjetaStyle}" FontSize="30" TextAlignment="Center"/>
                    </StackPanel>
                </Button>

            </UniformGrid>
        </Grid>
    </Grid>
</Window>
